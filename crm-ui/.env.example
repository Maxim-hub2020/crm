# Optional: set only if the UI must call an external API host.
VITE_API_BASE=
VITE_DADATA_API_KEY=

# Keep Gemini Live opt-in: the stable backend voice endpoint is safer locally and in production.
VITE_ASSISTANT_LIVE=0
VITE_ASSISTANT_LIVE_IOS=0
VITE_ASSISTANT_CLIENT_SILENCE_MS=1600
VITE_ASSISTANT_LIVE_RESPONSE_WATCHDOG_MS=14000
VITE_ASSISTANT_LIVE_MAX_UTTERANCE_MS=30000
VITE_ASSISTANT_LIVE_REFRESH_AFTER_TURN=1
VITE_ASSISTANT_STABLE_SILENCE_MS=3000
VITE_ASSISTANT_STABLE_MAX_UTTERANCE_MS=30000
VITE_ASSISTANT_TTS_MAX_MS=18000
VITE_ASSISTANT_TEXT_TIMEOUT_MS=22000
VITE_ASSISTANT_PENDING_WATCHDOG_MS=60000
