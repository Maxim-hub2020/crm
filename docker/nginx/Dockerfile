FROM public.ecr.aws/docker/library/node:20-alpine AS frontend-build

WORKDIR /frontend

COPY crm-ui/package*.json ./
RUN npm ci

COPY crm-ui/ ./

ARG VITE_API_BASE=""
ARG VITE_DADATA_API_KEY=""
ARG VITE_ASSISTANT_LIVE="0"
ARG VITE_ASSISTANT_LIVE_IOS="0"
ARG VITE_ASSISTANT_CLIENT_SILENCE_MS="1600"
ARG VITE_ASSISTANT_LIVE_RESPONSE_WATCHDOG_MS="14000"
ARG VITE_ASSISTANT_LIVE_MAX_UTTERANCE_MS="30000"
ARG VITE_ASSISTANT_LIVE_REFRESH_AFTER_TURN="1"
ARG VITE_ASSISTANT_STABLE_SILENCE_MS="3000"
ARG VITE_ASSISTANT_STABLE_MAX_UTTERANCE_MS="30000"
ARG VITE_ASSISTANT_TTS_MAX_MS="18000"
ARG VITE_ASSISTANT_TEXT_TIMEOUT_MS="22000"
ARG VITE_ASSISTANT_PENDING_WATCHDOG_MS="26000"

ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_DADATA_API_KEY=$VITE_DADATA_API_KEY
ENV VITE_ASSISTANT_LIVE=$VITE_ASSISTANT_LIVE
ENV VITE_ASSISTANT_LIVE_IOS=$VITE_ASSISTANT_LIVE_IOS
ENV VITE_ASSISTANT_CLIENT_SILENCE_MS=$VITE_ASSISTANT_CLIENT_SILENCE_MS
ENV VITE_ASSISTANT_LIVE_RESPONSE_WATCHDOG_MS=$VITE_ASSISTANT_LIVE_RESPONSE_WATCHDOG_MS
ENV VITE_ASSISTANT_LIVE_MAX_UTTERANCE_MS=$VITE_ASSISTANT_LIVE_MAX_UTTERANCE_MS
ENV VITE_ASSISTANT_LIVE_REFRESH_AFTER_TURN=$VITE_ASSISTANT_LIVE_REFRESH_AFTER_TURN
ENV VITE_ASSISTANT_STABLE_SILENCE_MS=$VITE_ASSISTANT_STABLE_SILENCE_MS
ENV VITE_ASSISTANT_STABLE_MAX_UTTERANCE_MS=$VITE_ASSISTANT_STABLE_MAX_UTTERANCE_MS
ENV VITE_ASSISTANT_TTS_MAX_MS=$VITE_ASSISTANT_TTS_MAX_MS
ENV VITE_ASSISTANT_TEXT_TIMEOUT_MS=$VITE_ASSISTANT_TEXT_TIMEOUT_MS
ENV VITE_ASSISTANT_PENDING_WATCHDOG_MS=$VITE_ASSISTANT_PENDING_WATCHDOG_MS

RUN npm run build

FROM public.ecr.aws/docker/library/nginx:1.27-alpine

COPY docker/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-build /frontend/dist /usr/share/nginx/html

RUN mkdir -p /var/www/static /var/www/media
