{$APP_DOMAIN} {
    encode zstd gzip

    reverse_proxy nginx:80
}

calc.cehcrm.ru {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
    }

    @immutable path /assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    @no_cache path /index.html /sw.js /manifest.webmanifest /version.json
    header @no_cache Cache-Control "no-cache, no-store, must-revalidate"

    @api_preflight {
        method OPTIONS
        path /api/*
    }
    handle @api_preflight {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, PATCH, POST, OPTIONS"
        header Access-Control-Allow-Headers "Authorization, Content-Type"
        header Access-Control-Max-Age "86400"
        respond "" 204
    }

    handle /api/* {
        header Access-Control-Allow-Origin "*"
        header Cache-Control "no-store"
        reverse_proxy backend:8000
    }

    handle {
        root * /srv/shower-calculator/current
        try_files {path} {path}/ /index.html
        file_server
    }
}

amalgama.cehcrm.ru {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
    }

    @immutable path /assets/* /calculator/assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    @no_cache path / /index.html /calculator /calculator/ /calculator/index.html /calculator/version.json
    header @no_cache Cache-Control "no-cache, no-store, must-revalidate"

    @site_leads path /api/site-leads
    handle @site_leads {
        header Cache-Control "no-store"
        reverse_proxy amalgama-notifier:8080
    }

    @calculator_api path /api/public-calculator/*
    handle @calculator_api {
        header Cache-Control "no-store"
        reverse_proxy backend:8000
    }

    redir /calculator /calculator/ 308

    handle_path /calculator/* {
        root * /srv/shower-calculator-public/current
        try_files {path} {path}/ /index.html
        file_server
    }

    handle {
        reverse_proxy amalgama-site:80
    }
}
