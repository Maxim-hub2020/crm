# Copy this file to .env.chatwoot on the server before starting Chatwoot.

CHATWOOT_IMAGE=chatwoot/chatwoot:latest-ce
CHATWOOT_FRONTEND_URL=https://chats.cehcrm.ru
CHATWOOT_SECRET_KEY_BASE=change-me-to-a-long-random-secret

CHATWOOT_POSTGRES_DB=chatwoot
CHATWOOT_POSTGRES_USER=chatwoot
CHATWOOT_POSTGRES_PASSWORD=change-me-to-a-strong-chatwoot-db-password

TZ=Europe/Moscow

# Optional email settings for Chatwoot notifications.
# MAILER_SENDER_EMAIL=crm@cehcrm.ru
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
