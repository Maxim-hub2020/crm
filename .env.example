# Public domain for Caddy automatic HTTPS.
# Example: APP_DOMAIN=cehcrm.ru
APP_DOMAIN=cehcrm.ru
CALCULATOR_DOMAIN=calc.cehcrm.ru

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
ALLOWED_HOSTS=cehcrm.ru,calc.cehcrm.ru,localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=https://cehcrm.ru
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=0

# CORS can stay empty when frontend and API are served from the same domain.
CORS_ALLOW_ALL=0
CORS_ALLOWED_ORIGINS=

# PostgreSQL inside Docker Compose.
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-to-a-strong-db-password
DATABASE_URL=postgres://crm:change-me-to-a-strong-db-password@db:5432/crm

# Timezone
TIME_ZONE=Europe/Moscow
TZ=Europe/Moscow

# Gemini / Vertex AI for finance analytics.
# Put the service account json on the server at backend/secrets/vertex-sa.json.
GEMINI_BACKEND=vertex_ai
VERTEX_AI_PROJECT_ID=crm-a-52615261-92e17
VERTEX_AI_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/vertex-sa.json
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

# Dadata is used by backend to verify and normalize project object addresses.
DADATA_API_KEY=
DADATA_DEFAULT_REGION=Ростовская область
DADATA_DEFAULT_CITY=Ростов-на-Дону

# Yandex Disk OAuth app for CRM-managed project folders.
# Redirect URI in Yandex OAuth app:
# - preferred: https://cehcrm.ru/api/yandex-disk/oauth/callback/
# - if Yandex only allows verification code: https://oauth.yandex.ru/verification_code
YANDEX_DISK_CLIENT_ID=
YANDEX_DISK_CLIENT_SECRET=
YANDEX_DISK_REDIRECT_URI=https://cehcrm.ru/api/yandex-disk/oauth/callback/
YANDEX_DISK_SCOPES=

# Frontend build-time variables. Keep VITE_API_BASE empty for same-origin production.
VITE_API_BASE=
