# Public domain for Caddy automatic HTTPS.
# Example: APP_DOMAIN=crm.example.ru
APP_DOMAIN=crm.example.ru

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
ALLOWED_HOSTS=crm.example.ru,www.crm.example.ru,localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=https://crm.example.ru,https://www.crm.example.ru
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=0

# CORS can stay empty when frontend and API are served from the same domain.
CORS_ALLOW_ALL=0
CORS_ALLOWED_ORIGINS=

# PostgreSQL inside Docker Compose.
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-to-a-strong-db-password
DATABASE_URL=postgres://crm:change-me-to-a-strong-db-password@db:5432/crm

# Timezone
TIME_ZONE=Europe/Moscow
TZ=Europe/Moscow

# Gemini / Vertex AI.
# Put the service account json on the server at backend/secrets/vertex-sa.json.
GEMINI_BACKEND=vertex_ai
VERTEX_AI_PROJECT_ID=crm-a-52615261-92e17
VERTEX_AI_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/vertex-sa.json
GEMINI_MODEL=gemini-2.5-flash
GEMINI_AUDIO_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_LANGUAGE_CODE=ru-RU
GEMINI_TTS_STYLE=Read the answer in Russian naturally, friendly and confidently, as a smart CRM voice assistant.

# Gemini Live API.
GEMINI_LIVE_LOCATION=europe-west1
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_SILENCE_MS=2000

# Frontend build-time variables. Keep VITE_API_BASE empty for same-origin production.
VITE_API_BASE=
VITE_ASSISTANT_LIVE=1
VITE_ASSISTANT_CLIENT_SILENCE_MS=1600
VITE_ASSISTANT_LIVE_RESPONSE_WATCHDOG_MS=14000
VITE_ASSISTANT_LIVE_MAX_UTTERANCE_MS=30000
VITE_ASSISTANT_LIVE_REFRESH_AFTER_TURN=1
VITE_ASSISTANT_STABLE_SILENCE_MS=3000
VITE_ASSISTANT_STABLE_MAX_UTTERANCE_MS=30000
VITE_ASSISTANT_TTS_MAX_MS=18000
VITE_ASSISTANT_TEXT_TIMEOUT_MS=22000
VITE_ASSISTANT_PENDING_WATCHDOG_MS=26000

# AI memory worker.
CRM_AI_MEMORY_TTL_SECONDS=1800
CRM_AI_MEMORY_REFRESH_INTERVAL_SECONDS=120
